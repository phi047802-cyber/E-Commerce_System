<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iOS Universal Links: https://<domain>/go/* và /app/* (xác minh qua /.well-known/apple-app-site-association).
	     Thay instasquad.example bằng domain thật và cấu hình Apple Team ID khi phát hành (DEFERRED, D36). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:instasquad.example</string>
	</array>
</dict>
</plist>
