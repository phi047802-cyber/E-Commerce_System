// INSTASQUAD — Prisma Schema
// CSDL trung tâm: Microsoft SQL Server 2022 (D33). Quy ước ánh xạ SQL Server: xem D34 trong docs/DECISION_LOG.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  user_id       String   @id @default(uuid())
  email         String   @unique
  password_hash String
  display_name  String
  phone_number  String?
  role          String   @default("RENTER") // RENTER, COMPANION, CS_AGENT, AUDITOR, ADMIN
  status        String   @default("ACTIVE") // ACTIVE, SUSPENDED, BANNED
  suspended_until DateTime? // Hạn tạm khóa do vi phạm (TERMS_AND_CONTRACTS.md Phần C)
  is_email_verified Boolean @default(true) // Đã xác minh email (UC01)
  avatar_url    String? @db.NVarChar(Max)  // Ảnh đại diện bảo mật (REF-PROF-01)
  bio           String? @db.NVarChar(Max)  // Tiểu sử / giới thiệu bản thân
  date_of_birth DateTime? // Ngày sinh
  favorite_games String? @db.NVarChar(Max) // Danh sách game yêu thích (chuỗi JSON hoặc danh sách phân tách dấu phẩy)
  google_id     String?  @unique // Google OAuth2 Account ID (FR-001)
  is_onboarding_completed Boolean @default(true) // Trạng thái hoàn thiện hồ sơ sau đăng nhập Google (FR-001)
  // Kênh nguồn first-touch lúc đăng ký (G9 — conversion theo utm_source). Web/App gửi UTM đã lưu từ lượt truy cập/deep link đầu tiên.
  signup_utm_source   String?
  signup_utm_medium   String?
  signup_utm_campaign String?
  created_at    DateTime @default(now())

  // Quan hệ
  companion_profile   CompanionProfile?
  wallet              Wallet?
  bookings_as_renter  Booking[]            @relation("RenterBookings")
  bookings_cancelled  Booking[]            @relation("CancelledByBookings")
  booking_changes     BookingStatusHistory[]
  chat_messages       ChatMessage[]
  call_logs_initiated CallLog[]            @relation("CallInitiator")
  call_logs_received  CallLog[]            @relation("CallReceiver")
  disputes_as_renter  DisputeCase[]        @relation("RenterDisputes")
  evidences_uploaded  DisputeEvidence[]
  decisions_as_cs     DisputeDecision[]
  reviews_written     Review[]             @relation("Reviewer")
  reviews_received    Review[]             @relation("Reviewee")
  notifications       Notification[]
  audit_logs          AuditLog[]
  alerts_resolved     LedgerAuditAlert[]
  kyc_records         KycRecord[]          @relation("UserKycRecords")
  kyc_reviews         KycRecord[]          @relation("KycReviewer")
  terms_acceptances   TermsAcceptance[]
  violations          ViolationRecord[]    @relation("ViolationSubject")
  violations_recorded ViolationRecord[]    @relation("ViolationRecorder")

  @@index([signup_utm_source])
  @@map("users")
}

model CompanionProfile {
  profile_id          String   @id @default(uuid())
  user_id             String   @unique
  game_id             String?
  verified_tier_id    String?
  hourly_rate         Int?     // Số nguyên VND
  profile_status      String   @default("INCOMPLETE") // INCOMPLETE, ACTIVE
  verification_status String   @default("UNVERIFIED") // UNVERIFIED, PENDING_REVIEW, VERIFIED
  availability        String   @default("OFFLINE") // ONLINE, BUSY, OFFLINE
  trust_score         Float    @default(80.00) // Khởi tạo 80.00 theo Demo Policy
  audio_bio_url       String? @db.NVarChar(Max)
  game_account_id     String?
  max_hours_per_day   Int      @default(10) // Giới hạn giờ nhận đơn/ngày (REF-PROF-01, BR-03, D08)
  created_at          DateTime @default(now())

  // Quan hệ
  user             User             @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  game             GameCatalog?     @relation(fields: [game_id], references: [game_id], onDelete: NoAction, onUpdate: NoAction)
  tier             SkillRankTier?   @relation(fields: [verified_tier_id], references: [tier_id], onDelete: NoAction, onUpdate: NoAction)
  slots            SlotCalendar[]
  bookings         Booking[]
  trust_score_logs TrustScoreLog[]

  @@map("companion_profiles")
}

model GameCatalog {
  game_id    String   @id
  game_name  String
  publisher  String
  genre      String
  category   String   @default("GAME") // GAME | SOCIAL (dịch vụ Non-gamer, D35)
  description String? @db.NVarChar(Max)
  is_active  Boolean  @default(true)

  // Quan hệ
  tiers      SkillRankTier[]
  profiles   CompanionProfile[]

  @@map("game_catalog")
}

model SkillRankTier {
  tier_id     String   @id
  game_id     String
  tier_name   String
  rank_weight Int

  // Quan hệ
  game        GameCatalog        @relation(fields: [game_id], references: [game_id], onDelete: Cascade, onUpdate: NoAction)
  profiles    CompanionProfile[]

  @@map("skill_rank_tier")
}

model SlotCalendar {
  slot_id    String   @id @default(uuid())
  profile_id String
  start_time DateTime
  end_time   DateTime
  status     String   @default("AVAILABLE") // AVAILABLE, HELD, BOOKED, REMOVED (xóa mềm khi slot từng có đơn)
  held_until DateTime?
  created_at DateTime @default(now())

  // Quan hệ
  profile    CompanionProfile @relation(fields: [profile_id], references: [profile_id], onDelete: Cascade, onUpdate: NoAction)
  bookings   Booking[] // Nhiều booking theo thời gian (đơn đã hủy + đơn đặt lại); tối đa 1 đơn chưa hủy (D45)

  @@index([profile_id, start_time])
  @@index([status, held_until])
  @@map("slot_calendar")
}

model Booking {
  booking_id          String   @id @default(uuid())
  renter_id           String
  profile_id          String
  slot_id             String   // D45: không UNIQUE toàn cột — filtered unique index `bookings_slot_id_active_key` (status <> CANCELLED) trong migration
  request_key         String   @unique // Chống đặt trùng (BR-01)
  start_time          DateTime
  duration_hours      Int
  total_fee_snapshot  Int      // Số nguyên VND chốt tại thời điểm đặt (BR-04)
  status              String   @default("PENDING_ACCEPTANCE") // PENDING_ACCEPTANCE, ACCEPTED, IN_SESSION, COMPLETED, CANCELLED, DISPUTED, REFUNDED
  response_deadline   DateTime // 180s đếm ngược (BR-08)
  confirm_deadline    DateTime? // 15 phút nghiệm thu (BR-14)
  cancel_reason       String? @db.NVarChar(Max)
  cancelled_by        String?
  cancelled_at        DateTime?
  created_at          DateTime @default(now())

  // Quan hệ
  renter              User                   @relation("RenterBookings", fields: [renter_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  companion           CompanionProfile       @relation(fields: [profile_id], references: [profile_id], onDelete: NoAction, onUpdate: NoAction)
  slot                SlotCalendar           @relation(fields: [slot_id], references: [slot_id], onDelete: NoAction, onUpdate: NoAction)
  canceller           User?                  @relation("CancelledByBookings", fields: [cancelled_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  escrow              Escrow?
  history             BookingStatusHistory[]
  session             Session?
  dispute             DisputeCase?
  reviews             Review[]
  trust_logs          TrustScoreLog[]
  transactions        LedgerTransaction[]
  settlement_retry    SettlementRetryQueue?

  @@index([renter_id])
  @@index([profile_id])
  @@index([status])
  @@index([slot_id])
  @@map("bookings")
}

model BookingStatusHistory {
  history_id   Int      @id @default(autoincrement())
  booking_id   String
  from_status  String?
  to_status    String
  reason       String? @db.NVarChar(Max)
  changed_by   String?
  changed_at   DateTime @default(now())

  // Quan hệ
  booking      Booking  @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade, onUpdate: NoAction)
  actor        User?    @relation(fields: [changed_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction)

  @@index([booking_id])
  @@map("booking_status_history")
}

model Session {
  session_id   String   @id @default(uuid())
  booking_id   String   @unique
  status       String   @default("SCHEDULED") // SCHEDULED, ACTIVE, ENDED, CLOSED
  start_time   DateTime
  end_time     DateTime
  room_token   String   @unique
  created_at   DateTime @default(now())

  // Quan hệ
  booking      Booking       @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade, onUpdate: NoAction)
  messages     ChatMessage[]
  call_logs    CallLog[]

  @@map("sessions")
}

model CallLog {
  call_id      String    @id @default(uuid())
  session_id   String
  caller_id    String
  receiver_id  String?
  started_at   DateTime  @default(now())
  ended_at     DateTime?
  duration_sec Int       @default(0)
  events       String? @db.NVarChar(Max)   // JSON mảng sự kiện: [{ event, timestamp, details }]
  result       String    @default("COMPLETED") // COMPLETED, MISSED, REJECTED, FAILED
  created_at   DateTime  @default(now())

  // Quan hệ
  session      Session   @relation(fields: [session_id], references: [session_id], onDelete: Cascade, onUpdate: NoAction)
  caller       User      @relation("CallInitiator", fields: [caller_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  receiver     User?     @relation("CallReceiver", fields: [receiver_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([session_id])
  @@map("call_logs")
}

model ChatMessage {
  message_id       Int      @id @default(autoincrement())
  session_id       String
  sender_id        String
  content          String @db.NVarChar(Max)   // Nội dung đã kiểm duyệt
  is_censored      Boolean  @default(false)
  original_content String? @db.NVarChar(Max)  // Nội dung gốc phục vụ kiểm toán
  created_at       DateTime @default(now())

  // Quan hệ
  session          Session  @relation(fields: [session_id], references: [session_id], onDelete: Cascade, onUpdate: NoAction)
  sender           User     @relation(fields: [sender_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([session_id, created_at])
  @@map("chat_messages")
}

model Wallet {
  wallet_id         String   @id @default(uuid())
  user_id           String   @unique
  wallet_type       String   @default("STANDARD")
  available_balance Int      @default(0) // Số nguyên VND >= 0
  escrow_balance    Int      @default(0) // Số nguyên VND >= 0
  penalty_debt      Int      @default(0) // Số nguyên VND >= 0 ghi nhận nợ phạt (D22)
  version           Int      @default(1) // Optimistic Lock
  updated_at        DateTime @default(now())

  // Quan hệ
  user              User                @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  entries           LedgerEntry[]
  withdrawals       WithdrawalRequest[]

  @@map("wallets")
}

model Escrow {
  escrow_id   String   @id @default(uuid())
  booking_id  String   @unique
  amount      Int      // Số nguyên VND
  status      String   @default("HELD") // HELD, FROZEN, RELEASED, REFUNDED
  held_at     DateTime @default(now())
  frozen_at   DateTime?
  released_at DateTime?
  refunded_at DateTime?

  // Quan hệ
  booking     Booking             @relation(fields: [booking_id], references: [booking_id], onDelete: NoAction, onUpdate: NoAction)
  transactions LedgerTransaction[]

  @@map("escrows")
}

model LedgerTransaction {
  txn_id          String   @id @default(uuid())
  booking_id      String?
  escrow_id       String?
  txn_type        String   // TOPUP, ESCROW_HOLD, ESCROW_RELEASE, ESCROW_REFUND, CANCEL_PENALTY, DISPUTE_SETTLE, WITHDRAW_RESERVE, WITHDRAW_SETTLE, WITHDRAW_REJECT
  idempotency_key String   @unique // Chống cộng trừ trùng
  created_at      DateTime @default(now())

  // Quan hệ
  booking         Booking?           @relation(fields: [booking_id], references: [booking_id], onDelete: SetNull, onUpdate: NoAction)
  escrow          Escrow?            @relation(fields: [escrow_id], references: [escrow_id], onDelete: SetNull, onUpdate: NoAction)
  entries         LedgerEntry[]
  payment         Payment?
  platform_revenue PlatformRevenue?
  withdrawal      WithdrawalRequest?
  alerts          LedgerAuditAlert[]

  @@index([idempotency_key])
  @@index([booking_id])
  @@map("ledger_transactions")
}

model LedgerEntry {
  entry_id      String   @id @default(uuid())
  txn_id        String
  wallet_id     String
  direction     String   // DEBIT, CREDIT
  balance_type  String   // AVAILABLE, ESCROW
  amount        Int      // Số nguyên VND > 0
  balance_after Int      // Số dư sau khi ghi nhận
  created_at    DateTime @default(now())

  // Quan hệ
  transaction   LedgerTransaction @relation(fields: [txn_id], references: [txn_id], onDelete: Cascade, onUpdate: NoAction)
  wallet        Wallet            @relation(fields: [wallet_id], references: [wallet_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([wallet_id, created_at])
  @@index([txn_id])
  @@map("ledger_entries")
}

model Payment {
  payment_id   String   @id @default(uuid())
  txn_id       String?  @unique
  wallet_id    String
  provider     String   @default("MOCK_VNPAY") // MOCK_VNPAY, MOCK_MOMO
  gateway_ref  String   @unique
  amount       Int      // Số nguyên VND
  status       String   @default("PENDING") // PENDING, SUCCESS, FAILED, EXPIRED, LATE
  created_at   DateTime @default(now())
  processed_at DateTime?
  expires_at   DateTime?
  qr_url       String? @db.NVarChar(Max)
  sepay_id     String?

  // Quan hệ
  transaction  LedgerTransaction? @relation(fields: [txn_id], references: [txn_id], onDelete: SetNull, onUpdate: NoAction)

  @@index([gateway_ref])
  @@map("payments")
}

model PlatformRevenue {
  revenue_id      String   @id @default(uuid())
  txn_id          String   @unique
  amount          Int      // Số nguyên VND (12% hoa hồng)
  commission_rate Float    @default(0.12)
  created_at      DateTime @default(now())

  // Quan hệ
  transaction     LedgerTransaction @relation(fields: [txn_id], references: [txn_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("platform_revenues")
}

model WithdrawalRequest {
  withdraw_id       String   @id @default(uuid())
  wallet_id         String
  txn_id            String?  @unique
  amount            Int      // Số nguyên VND
  bank_name         String
  account_no_masked String
  status            String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, REJECTED
  processed_by      String?
  reject_reason     String? @db.NVarChar(Max)
  payout_code       String?
  idempotency_key   String?  @unique
  processed_at      DateTime?
  created_at        DateTime @default(now())

  // Quan hệ
  wallet            Wallet             @relation(fields: [wallet_id], references: [wallet_id], onDelete: NoAction, onUpdate: NoAction)
  transaction       LedgerTransaction? @relation(fields: [txn_id], references: [txn_id], onDelete: SetNull, onUpdate: NoAction)

  @@index([wallet_id])
  @@map("withdrawal_requests")
}

model DisputeCase {
  dispute_id            String    @id @default(uuid())
  booking_id            String    @unique // Chống tạo trùng khiếu nại (BR-26)
  renter_id             String
  reason_category       String   // NO_SHOW, HARASSMENT, SKILL_MISMATCH, TECHNICAL_ISSUE
  description           String @db.NVarChar(Max)
  status                String    @default("OPENED") // OPENED, EVIDENCE_PENDING, UNDER_REVIEW, RESOLVED, CLOSED
  evidence_deadline     DateTime? // Hạn 24 giờ nộp bổ sung bằng chứng (D25)
  evidence_requested_at DateTime? // Thời điểm bắt đầu tạm dừng đồng hồ SLA (D25)
  paused_sla_ms         Int       @default(0) // Tổng mili-giây SLA đã tạm dừng khi chờ chứng cứ (D25)
  evidence_requested_by String?   // CS Agent ID yêu cầu bổ sung chứng cứ
  evidence_request_note String? @db.NVarChar(Max)   // Ghi chú cụ thể của CS khi yêu cầu bổ sung
  companion_explanation String? @db.NVarChar(Max)   // Lời giải trình của Companion (D29)
  companion_explained_at DateTime? // Thời điểm Companion gửi giải trình
  created_at            DateTime  @default(now())
  resolved_at           DateTime?

  // Quan hệ
  booking         Booking           @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade, onUpdate: NoAction)
  renter          User              @relation("RenterDisputes", fields: [renter_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  evidences       DisputeEvidence[]
  decision        DisputeDecision?

  @@map("dispute_cases")
}

model DisputeEvidence {
  evidence_id String   @id @default(uuid())
  dispute_id  String
  uploader_id String
  file_url    String @db.NVarChar(Max)
  file_type   String   // IMAGE_PNG, IMAGE_JPEG, LOG_TEXT
  description String? @db.NVarChar(Max)
  created_at  DateTime @default(now())

  // Quan hệ
  dispute     DisputeCase @relation(fields: [dispute_id], references: [dispute_id], onDelete: Cascade, onUpdate: NoAction)
  uploader    User        @relation(fields: [uploader_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([dispute_id])
  @@map("dispute_evidences")
}

model DisputeDecision {
  decision_id     String   @id @default(uuid())
  dispute_id      String   @unique
  cs_agent_id     String
  fault_percent   Int      // Tỷ lệ lỗi Companion (0 - 100)
  refund_amount   Int      @default(0) // Số nguyên VND hoàn Renter
  penalty_amount  Int      @default(0) // Số nguyên VND phạt Companion
  decision_reason String @db.NVarChar(Max)   // Lý do bắt buộc theo D15
  created_at      DateTime @default(now())

  // Quan hệ
  dispute         DisputeCase @relation(fields: [dispute_id], references: [dispute_id], onDelete: Cascade, onUpdate: NoAction)
  cs_agent        User        @relation(fields: [cs_agent_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("dispute_decisions")
}

model Review {
  review_id   Int      @id @default(autoincrement())
  booking_id  String
  reviewer_id String
  reviewee_id String
  rating      Int      // 1 đến 5 sao
  comment     String? @db.NVarChar(Max)
  created_at  DateTime @default(now())

  // Quan hệ
  booking     Booking  @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade, onUpdate: NoAction)
  reviewer    User     @relation("Reviewer", fields: [reviewer_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  reviewee    User     @relation("Reviewee", fields: [reviewee_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([booking_id, reviewer_id]) // Mỗi người chỉ đánh giá 1 lần/booking (BR-22, D17)
  @@map("reviews")
}

model TrustScoreLog {
  log_id      Int      @id @default(autoincrement())
  profile_id  String
  booking_id  String?
  reason_code String
  delta       Float
  score_after Float
  created_at  DateTime @default(now())

  // Quan hệ
  profile     CompanionProfile @relation(fields: [profile_id], references: [profile_id], onDelete: Cascade, onUpdate: NoAction)
  booking     Booking?         @relation(fields: [booking_id], references: [booking_id], onDelete: SetNull, onUpdate: NoAction)

  @@index([profile_id])
  @@map("trust_score_logs")
}

model Notification {
  notification_id Int      @id @default(autoincrement())
  user_id         String
  title           String
  message         String @db.NVarChar(Max)
  type            String
  target_url      String? @db.NVarChar(Max)
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now())

  // Quan hệ
  user            User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, is_read])
  @@map("notifications")
}

model AuditLog {
  audit_id     Int      @id @default(autoincrement())
  actor_id     String?
  action       String
  entity_type  String
  entity_id    String
  payload_json String? @db.NVarChar(Max)
  ip_address   String?
  created_at   DateTime @default(now())

  // Quan hệ
  actor        User?    @relation(fields: [actor_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction)

  @@index([entity_type, entity_id])
  @@map("audit_logs")
}

model LedgerAuditAlert {
  alert_id      Int      @id @default(autoincrement())
  txn_id        String?
  error_code    String
  error_message String @db.NVarChar(Max)
  context_json  String? @db.NVarChar(Max)
  repeat_count  Int      @default(1)
  is_resolved   Boolean  @default(false)
  resolved_by   String?
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  // Quan hệ
  transaction   LedgerTransaction? @relation(fields: [txn_id], references: [txn_id], onDelete: SetNull, onUpdate: NoAction)
  resolver      User?              @relation(fields: [resolved_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([is_resolved])
  @@map("ledger_audit_alerts")
}

model AuthOtp {
  otp_id      String   @id @default(uuid())
  email       String
  otp_hash    String
  purpose     String   // FORGOT_PASSWORD, EMAIL_VERIFICATION
  attempts    Int      @default(0)
  expires_at  DateTime
  created_at  DateTime @default(now())

  @@index([email, purpose])
  @@map("auth_otps")
}

model KycRecord {
  kyc_id           String    @id @default(uuid())
  user_id          String
  id_front_path    String
  id_front_iv      String
  id_front_tag     String
  id_back_path     String
  id_back_iv       String
  id_back_tag      String
  selfie_path      String
  selfie_iv        String
  selfie_tag       String
  status           String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  rejection_reason String? @db.NVarChar(Max)
  reviewed_by      String?
  reviewed_at      DateTime?
  created_at       DateTime  @default(now())

  // Quan hệ
  user             User      @relation("UserKycRecords", fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  reviewer         User?     @relation("KycReviewer", fields: [reviewed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id])
  @@index([status])
  @@map("kyc_records")
}

model SiteVisit {
  visit_id    String   @id @default(uuid())
  session_key String   @unique
  ip_hash     String?
  user_agent  String? @db.NVarChar(Max)
  utm_source   String? // tiktok | facebook | instagram | threads | referral ... (G8)
  utm_medium   String?
  utm_campaign String?
  landing_path String?
  created_at  DateTime @default(now())

  @@map("site_visits")
}

model SettlementRetryQueue {
  retry_id        String   @id @default(uuid())
  booking_id      String   @unique
  attempts        Int      @default(0) // Số lần đã thử lại (D26: tối đa 3 lần sau 1, 5, 15 phút)
  max_attempts    Int      @default(3)
  next_retry_at   DateTime
  idempotency_key String   // CÙNG idempotency_key trên mọi lần thử (D26)
  last_error      String? @db.NVarChar(Max)
  status          String   @default("PENDING") // PENDING, SUCCESS, EXHAUSTED
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  booking         Booking  @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("settlement_retry_queue")
}

model News {
  news_id      String   @id @default(uuid())
  slug         String   @unique
  title        String
  summary      String @db.NVarChar(Max)
  content      String @db.NVarChar(Max)
  category     String
  image_url    String
  author       String   @default("Ban Quản Trị INSTASQUAD")
  published_at DateTime @default(now())
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@map("news")
}


// ============================================================
// Pháp lý (TERMS_AND_CONTRACTS.md) — Bước 3 nâng cấp đa nền tảng
// ============================================================

model TermsAcceptance {
  acceptance_id String   @id @default(uuid())
  user_id       String
  terms_version String   // ví dụ TOS-2026.11
  channel       String   @default("WEB") // WEB | MOBILE
  ip_hash       String?
  accepted_at   DateTime @default(now())

  user          User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, terms_version])
  @@map("terms_acceptances")
}

model ViolationRecord {
  violation_id     String   @id @default(uuid())
  user_id          String   // Người vi phạm
  code             String   // V01..V08 (TERMS_AND_CONTRACTS.md Phần C)
  severity         String   // LOW | MEDIUM | HIGH | CRITICAL
  booking_id       String?
  trust_delta      Float    @default(0)
  suspension_days  Int      @default(0) // 0 = không khóa; -1 = khóa vĩnh viễn
  note             String   @db.NVarChar(Max)
  recorded_by      String   // CS Agent / Admin
  created_at       DateTime @default(now())

  user             User     @relation("ViolationSubject", fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  recorder         User     @relation("ViolationRecorder", fields: [recorded_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id, code])
  @@map("violation_records")
}
