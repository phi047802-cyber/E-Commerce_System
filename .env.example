# ========================================================
# INSTASQUAD Environment Variables Template (.env.example)
# Sao chép file này thành .env và chỉnh sửa cấu hình nếu cần
# ========================================================

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (SQLite local mặc định)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret
JWT_SECRET=instasquad_demo_jwt_secret_change_in_production_key_123456

# CORS Origin (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# Demo Policy & Business Rules Constants
SLOT_HOLD_TTL_MINUTES=10
FULFILLMENT_ACCEPTANCE_TIMEOUT_MINUTES=15
BOOKING_RESPONSE_TIMEOUT_SECONDS=180
MAX_COMPANION_HOURS_PER_DAY=10

# Mock Payment Simulator Secret (HMAC SHA-256)
SIMULATOR_SECRET=mock_vnpay_momo_secret_key_demo_2026

# Payment Gateway Configuration (Dot C: Pluggable Payment Provider)
PAYMENT_PROVIDER=simulator
SEPAY_WEBHOOK_API_KEY=sepay_demo_api_key_2026
SEPAY_ACCOUNT_NUMBER=0123456789
SEPAY_BANK_CODE=MBBank
SEPAY_ACCOUNT_NAME="CONG TY INSTASQUAD"
PUBLIC_BASE_URL=http://localhost:4000

# Background Worker Scheduler Configuration (Tùy chọn cấu hình tự động hóa nền)
ENABLE_BACKGROUND_WORKER=true
BACKGROUND_WORKER_INTERVAL_MS=5000

# Mailer SMTP Configuration (Tùy chọn trong dev, log console nếu để trống)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=mock_mailer_user
SMTP_PASS=mock_mailer_password
SMTP_FROM="InstaSquad Support <support@instasquad.vn>"

# AES-256-GCM Encryption Key for eKYC (Bắt buộc đúng 32 byte trong production)
EKYC_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# AES-256-GCM Encryption Key for Dispute Evidence and Messages (NFR-002, Bắt buộc đúng 32 byte trong production, khác eKYC)
DATA_ENCRYPTION_KEY=fedcba9876543210fedcba9876543210

# Google OAuth2 Client ID (FR-001)
GOOGLE_CLIENT_ID=mock-google-client-id-demo-2026.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=mock-google-client-id-demo-2026.apps.googleusercontent.com

# WebRTC ICE Servers (STUN/TURN) (FR-006)
ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"}]'
