{
  "name": "instasquad",
  "version": "1.0.0",
  "description": "INSTASQUAD — Multi-platform Game & Social Companion Platform (Web + Flutter, SQL Server)",
  "private": true,
  "main": "server/src/server.ts",
  "scripts": {
    "dev:server": "tsx server/src/server.ts",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "check:links": "node scripts/dev-tools/check_links.js",
    "verify:quotes": "node scripts/dev-tools/verify_quotes.js",
    "lint:claims": "node scripts/dev-tools/lint_claims.js",
    "lint:ui-text": "node scripts/dev-tools/lint_ui_text.js",
    "ui:smoke": "node scripts/dev-tools/ui_smoke.js",
    "setup": "npm install --ignore-scripts && npm --prefix client install && npx prisma generate && node scripts/db/ensure-database.mjs && npx prisma migrate deploy && npm run prisma:seed",
    "db:up": "docker compose up -d mssql",
    "db:create": "node scripts/db/ensure-database.mjs",
    "db:reset": "node scripts/db/ensure-database.mjs && prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "ledger:reconcile": "tsx scripts/db/reconcile-ledger.ts"
  },
  "dependencies": {
    "@prisma/client": "6.4.0",
    "@types/nodemailer": "^6.4.17",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jimp": "^1.6.1",
    "jose": "^6.2.17",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.14",
    "concurrently": "^9.1.2",
    "prisma": "6.4.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
